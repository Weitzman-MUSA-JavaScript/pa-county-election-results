{
  "name": "pa-county-election-map",
  "version": "1.0.0",
  "description": "Pennsylvania County Election Map",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.48.0",
    "eslint-config-google": "^0.14.0",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^34.0.0"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "google"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "env": {
      "browser": true
    },
    "ignorePatterns": ["examples/**/*.js"],
    "globals": {
      "L": "readonly"
    },
    "rules": {
      "indent": ["error", 2, {"MemberExpression": 1}],
      "object-curly-spacing": "off",
      "max-len": "off",
      "require-jsdoc": "off"
    }
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "ignoreFiles": ["examples/**/*.css"],
    "rules": {
      "declaration-empty-line-before": null,
      "declaration-block-no-redundant-longhand-properties": null
    }
  }
}
